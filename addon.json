{
    "id": "addon-watchlist",
    "name": "Player Watchlist",
    "description": "Monitor players with a watchlist.",
    "version": "1.0.1",
    "author": "entytaiment25",
    "license": "MIT",
    "fxpanel": {
        "minVersion": "0.3.0-Beta"
    },
    "permissions": {
        "required": ["storage", "ws.push", "players.read", "players.write"],
        "optional": []
    },
    "server": {
        "entry": "server/index.js"
    },
    "panel": {
        "entry": "panel/index.js",
        "pages": [
            {
                "path": "/watchlist",
                "title": "Watchlist",
                "icon": "Eye",
                "sidebar": true,
                "sidebarGroup": "Players",
                "permission": "players.reports",
                "component": "WatchlistPage"
            }
        ],
        "widgets": [
            {
                "slot": "player-modal.tabs",
                "component": "WatchlistPlayerModal",
                "title": "Watchlist"
            },
            {
                "slot": "dashboard.main",
                "component": "WatchlistDashboardWidget",
                "title": "Watchlist Activity",
                "defaultSize": "half",
                "permission": "players.reports"
            }
        ]
    }
}
